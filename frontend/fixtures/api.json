 "/api/v1/tour": {
  "schema_version": "public.v1",
  "source_mode": "FROZEN_REPLAY",
  "source_label": "committed evidence",
  "observed_at": "2026-09-17T12:00:00+00:00",
  "correlation_id": null,
  "data": [
   {
    "number": 1,
    "title": "What was observed",
    "narration": "Every decision starts from a recorded observation carrying its provider, feed, source time and payload hash. The underlying price is the last completed daily close, never a forming bar — the system cannot see a price it would not have had.",
    "tab": 0,
    "snapshot_id": "spy-qualified-2026-08-27",
    "decision_id": "1a9b85507b66e5838b4c6f985179946e08c2b48b7d5433c260fd673d6c81f0d0"
   },
   {
    "number": 2,
    "title": "What the code decided before the model ran",
    "narration": "A deterministic classifier chose the direction and set the invalidation conditions. Both were fixed before any model was called, and the model has no field in which to return either.",
    "tab": 0,
    "snapshot_id": "spy-qualified-2026-08-27",
    "decision_id": "1a9b85507b66e5838b4c6f985179946e08c2b48b7d5433c260fd673d6c81f0d0"
   },
   {
    "number": 3,
    "title": "What the model contributed",
    "narration": "The model returned a memo under a strict schema: direction, confidence, cited and counter-cited evidence, and a summary. A direction that disagrees with the setup is coerced to neutral and recorded as an attempt. This is its entire authority.",
    "tab": 1,
    "snapshot_id": "spy-qualified-2026-08-27",
    "decision_id": "1a9b85507b66e5838b4c6f985179946e08c2b48b7d5433c260fd673d6c81f0d0"
   },
   {
    "number": 4,
    "title": "What was authorized",
    "narration": "Deterministic risk sized the position and an immutable intent was recorded. The client order id is derived from the intent hash, so a duplicate submit collides at the broker instead of opening a second position.",
    "tab": 2,
    "snapshot_id": "spy-lifecycle-20260828T154747Z",
    "decision_id": "75a9cc71475697f276792fed4cac5af0b56c992b7cc3b899629c844493561e6d"
   },
   {
    "number": 5,
    "title": "What Alpaca actually did",
    "narration": "One Paper round trip, reconciled to flat. Acknowledgement was recorded as SUBMITTED; the fills were written only from a reconciled broker record. The round trip lost money, which is on screen because a demo that shows only the winning trade is a brochure.",
    "tab": 3,
    "snapshot_id": "spy-lifecycle-20260828T154747Z",
    "decision_id": "75a9cc71475697f276792fed4cac5af0b56c992b7cc3b899629c844493561e6d"
   },
   {
    "number": 6,
    "title": "What refusal looks like",
    "narration": "The setup did not qualify, so the model was never called. There is no memo to reject — the question never reached it. This costs one classifier and no tokens, and is recorded with the same evidence hashes as a trade.",
    "tab": 1,
    "snapshot_id": "spy-refusal-2026-08-27",
    "decision_id": "8374de98a8af7fa09bdfb2bbcb0423fe6279879b5c53650acbda4e2affdcd8b2"
   }
  ]
 },
 "/api/v1/copy": {
  "schema_version": "public.v1",
  "source_mode": "FROZEN_REPLAY",
  "source_label": "committed evidence",
  "observed_at": "2026-09-17T12:00:00+00:00",
  "correlation_id": null,
  "data": {
   "what_this_is": "A read-only view of decisions this system already made. It has no controls: it cannot start a run, approve an intent, or reach a broker.",
   "disclosures": [
    "Alpaca **Paper** only. No live endpoint exists in this build.",
    "Option quotes come from the **indicative** feed. The account has no OPRA agreement, so quotes are not trading-quality.",
    "**No alpha is claimed.** A `NO_TRADE` refusal and a deterministic baseline beating the model are both valid results.",
    "Nothing here is investment advice."
   ],
   "write_guards": [
    {
     "name": "Configuration permits writes",
     "effect": "blocks any mode but paper_execute"
    },
    {
     "name": "Resolved endpoint is Paper",
     "effect": "blocks a client pointing anywhere else"
    },
    {
     "name": "Execution state allows the write",
     "effect": "blocks NO_NEW_RISK and FREEZE_ALL_WRITES"
    },
    {
     "name": "An operator has approved",
     "effect": "blocks an autonomous open when approval is required"
    },
    {
     "name": "No strategy already open",
     "effect": "blocks a second concurrent position"
    },
    {
     "name": "Intent has not expired",
     "effect": "blocks a stale approval past its 90 s TTL"
    },
    {
     "name": "Request still matches the intent hash",
     "effect": "blocks bytes that drifted after approval"
    }
   ],
   "write_guards_note": "They run before every order rather than at startup, because the interesting failures develop between the two. Risk-reducing closes are exempt from guards 3, 4 and 5: those exist to stop new risk, and applying them to an exit would trap exposure at the moment it most needs reducing.",
   "model_limits": [
    {
     "name": "Pick a direction",
     "effect": "may agree or abstain; a reversal is coerced to abstention"
    },
    {
     "name": "Change an invalidation level",
     "effect": "never sent to the model; absent from its schema"
    },
    {
     "name": "Size the position",
     "effect": "not in the prompt; computed after the memo"
    },
    {
     "name": "Choose the contracts",
     "effect": "deterministic, from the observed chain"
    },
    {
     "name": "Reach a broker",
     "effect": "no order tool exists on the model path"
    }
   ],
   "halt_states": [
    {
     "state": "NORMAL",
     "tone": "ok",
     "explanation": "New risk permitted. Closes and cancels also permitted."
    },
    {
     "state": "NO_NEW_RISK",
     "tone": "warn",
     "explanation": "New or increased risk blocked. Cancels and risk-reducing closes stay permitted, because blocking a close during a loss would trap exposure."
    },
    {
     "state": "FREEZE_ALL_WRITES",
     "tone": "bad",
     "explanation": "All writes blocked, including closes. Reserved for adapter, credential or endpoint integrity incidents, and it raises an incident precisely because it can temporarily prevent risk reduction."
    }
   ]
  }
 },
