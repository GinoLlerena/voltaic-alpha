{
  "name": "options-alpha-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "vitest run",
    "api-types": "openapi-typescript openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "@tanstack/react-router": "1.78.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@tanstack/router-devtools": "1.78.3",
    "@testing-library/jest-dom": "6.6.2",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.7.9",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "eslint": "9.13.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.4.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.11.0",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
