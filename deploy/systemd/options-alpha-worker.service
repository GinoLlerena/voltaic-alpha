[Unit]
Description=Options Alpha worker (single-writer decision agent)
# postgresql.service is only a wrapper; the database itself runs as the cluster
# unit. Ordering on the wrapper alone let a restart of both at once (needrestart,
# 21 Oct 2026, 08:50 ET) stop the database first. The worker's lease release then
# failed, and the new worker refused to start for 80 s while the lease expired.
# Ordering on the cluster makes systemd stop the worker first and start it last,
# and Requires= restarts the worker with the database.
After=network-online.target postgresql.service postgresql@16-main.service
Wants=network-online.target
Requires=postgresql.service postgresql@16-main.service

[Service]
Type=simple
WorkingDirectory=/opt/options-alpha
EnvironmentFile=/etc/options-alpha.env
RuntimeDirectory=options-alpha
RuntimeDirectoryMode=0755
# Disarmed on purpose. `observe` decides and records but prepares no order and
# reaches no broker. Arming is a separate, deliberate, recorded action that adds
# a paper_execute drop-in and an operator approval token.
ExecStart=/opt/options-alpha/.venv/bin/python -m options_alpha_lab.worker \
  --mode observe --symbol SPY --interval 300 \
  --health-file /var/run/options-alpha/health.json
Restart=on-failure
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
