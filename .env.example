# Create .env by running: python scripts/configure_secrets.py
# .env is gitignored and must never be committed, pasted into chat, or read by
# a review agent. Fill values locally only.
OPENAI_API_KEY=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Paper-only authority. ALPACA_TRADING_ENABLED stays false until the exact-request,
# idempotency, and reconciliation gates pass (implementation plan, Phase 4).
ALPACA_PAPER_TRADE=true
ALPACA_TRADING_ENABLED=false

# The bounded thesis memo. The model occupies exactly one seat in the workflow
# and cannot pick direction, alter the invalidation, size risk, choose contracts,
# or reach the broker - so these change how the memo reads, never what is
# decided. Effort is one of: none, low, medium, high, xhigh, max.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium

# Local PostgreSQL. Local-only credentials, not a secret. There is no
# docker-compose.yml in this repository (QA-013 is PENDING); point this at a
# PostgreSQL you run yourself, or at a SQLite file for offline work.
DATABASE_URL=postgresql+psycopg://options_alpha:options_alpha@localhost:5432/options_alpha
